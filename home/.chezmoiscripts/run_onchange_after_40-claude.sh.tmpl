#!/usr/bin/env bash
# Claude Code 本體 + 本機 mods；marketplace hash: {{ include "../claude/mods/.claude-plugin/marketplace.json" | sha256sum }}
set -euo pipefail
info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

# Claude Code 用官方安裝程式（會自動更新），不交給 mise
command -v claude >/dev/null 2>&1 || [[ -x "$HOME/.local/bin/claude" ]] || curl -fsSL https://claude.ai/install.sh | bash
export PATH="$HOME/.local/bin:$PATH"

# mods 以本機資料夾 marketplace 安裝：直接讀 repo 內的檔案，改完 /reload-plugins 生效
info "Claude Code mods"
claude plugin marketplace add {{ joinPath .chezmoi.workingTree "claude/mods" | quote }} || true
claude plugin install ports-backlog@dotfiles
