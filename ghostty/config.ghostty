# -- Theme --
theme = Catppuccin Mocha

# -- Font --
font-family = MesloLGS Nerd Font Mono
font-size = 13
font-thicken = true

# -- Window --
window-padding-x = 2
window-padding-y = 6
window-step-resize = false
background-opacity = 0.85
background-blur = true

# -- Cursor --
cursor-style = block
cursor-style-blink = false

# -- Behavior --
copy-on-select = true
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true
mouse-hide-while-typing = true
shell-integration = zsh
scrollback-limit = 100000
quit-after-last-window-closed = true
notify-on-command-finish = always
window-save-state = always
confirm-close-surface = false

# -- Quick Terminal --
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# -- macOS --
macos-titlebar-style = transparent
macos-option-as-alt = true
macos-auto-secure-input = true

# -- Keybinds --
keybind = ctrl+backquote=toggle_quick_terminal
keybind = cmd+right=text:\x05
keybind = cmd+left=text:\x01
keybind = cmd+backspace=text:\x15
keybind = cmd+shift+]=next_tab
keybind = cmd+shift+[=previous_tab
keybind = cmd+one=goto_tab:1
keybind = cmd+two=goto_tab:2
keybind = cmd+three=goto_tab:3
keybind = cmd+four=goto_tab:4
keybind = cmd+five=goto_tab:5
